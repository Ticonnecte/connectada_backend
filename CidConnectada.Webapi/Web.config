  <log4net>
    <appender name="AsyncRollingFileAppender" type="Zenite.Pi.Log.AsyncAppender, Zenite.Pi">
      <appender-ref ref="NetConsole" />
      <appender-ref ref="NetFileAppender" />
    </appender>
    <appender name="NetFileAppender" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="App_Logs\\Website_Logs.log" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="8MB" />
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="[%d][%t] %-5p [%C.%M] - %m%n" />
      </layout>
    </appender>
    <appender name="NetConsole" type="log4net.Appender.TraceAppender">
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="[%d][%t] %-5p [%C.%M] - %m%n" />
      </layout>
    </appender>
    <root>
      <level value="ALL" />
      <appender-ref ref="AsyncRollingFileAppender" />
      <level value="INFO" />
      <appender-ref ref="ConsoleAppender" />
    </root>
    <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger [%ndc] - %message%newline" />
      </layout>
    </appender>
  </log4net>
</configuration>
