        function getData(uri, useImei, useDataRef, trackerChippedId, hasGetAddress) {
            showCover('cover-transactions', 'Buscando dados...' + uri);
            var messageHandle = new CustomMessageApp('msg-transactions');
            messageHandle.clear();


            debugger;
            var isPeriod = $('#data-final').val() != undefined && $('#data-final').val() != '';

            var uriFinal = uri;
            var separator = uri.indexOf('?') > 0 ? '&' : '?';
            if (useImei || useDataRef) {
                if (useImei && useDataRef) {
                    if (isPeriod) {
                        uriFinal += separator + 'imei={0}&dtIni={1}&dtFinal={2}'.format($('#imei').val(), $('#data-ini').val(), $('#data-final').val());
                    }
                    else {
                        uriFinal += separator + 'imei={0}&dataRef={1}'.format($('#imei').val(), $('#data-ini').val());
                    }
                }
                else if (useImei) {
                    uriFinal += separator + 'imei={0}'.format($('#imei').val());
                }
                else {
                    if (isPeriod) {
                        uriFinal += separator + 'dtIni={0}&dtFinal={1}'.format($('#data-ini').val(), $('#data-final').val());
                    }
                    else {
                        uriFinal += separator + 'dataRef={0}'.format($('#data-ini').val());
                    }
                }
                if (trackerChippedId != undefined) {
                    uriFinal += '&tkrChipped={0}'.format(trackerChippedId);
                }
            }
            if (hasGetAddress) {
                uriFinal += '&getAddress=true';
            }

            var token = sessionStorage.getItem(tokenKey);
            var headers = {};
            if (token) {
                headers.Authorization = 'Bearer ' + token;
            }

            debugger;

            $.ajax({
                type: 'GET',
                url: uriFinal,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                headers: headers
            }).done(function (data, textStatus, jqXHR) {
                if (data) {
                    messageHandle.displayMessage(JSON.stringify(data), 'success', -1);
                }
            }).fail(function (jqXHR, textStatus, errorThrown) {
                debugger;
                messageHandle.displayMessage('Erro {0}. Details: {1}.'.format(jqXHR.status, jqXHR.responseText), 'danger', -1);
            }).always(function () {
                $('#cover-transactions').fadeOut(300);
            });
        }

